-- Basic LC-lang example demonstrating core features

pub fn main() -> Result() {
  let x = 10
  let y = 20
  let sum = x + y
  
  let message = "The sum is: " + tostring(sum)
  
  -- Conditional logic
  if sum > 0 {
    let positive = True
  } else {
    let positive = False
  }
  
  -- Function call
  let result = greet("World")
  
  return Ok(result)
}

pub fn greet(name: String) -> String {
  return "Hello, " + name + "!"
}
